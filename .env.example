OPENAI_API_KEY="YOUR_NEBIUS_API_KEY_HERE"
ANTHROPIC_API_KEY=claude-local
IGNORE_CLIENT_API_KEY=true

OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nebius rotates model availability — verify IDs against
#   GET https://api.tokenfactory.nebius.com/v1/models
# before committing. install.sh does this automatically.
# Single backend model for all Claude tiers (opus/sonnet/haiku). Per-session
# overrides via `claude --proxy` take precedence; this is the default.
MODEL=moonshotai/Kimi-K2.6
VISION_MODEL=moonshotai/Kimi-K2.6
# Context limit (tokens) for max_tokens auto-capping and message trimming.
# install.sh sets this automatically from the model's context_length in the
# Nebius catalog. 0 = let the runtime catalog decide (safe default).
MODEL_CONTEXT_LIMIT=0
VISION_MODEL_CONTEXT_LIMIT=0
STRIP_IMAGE_CONTEXT=true

# Claude Code request optimizations
# These answer low-value housekeeping requests locally instead of spending
# Nebius latency/tokens. Set ENABLE_REQUEST_OPTIMIZATIONS=false to disable all
# of them, or flip individual handlers below for targeted debugging.
ENABLE_REQUEST_OPTIMIZATIONS=true
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true

# Bind loopback by default: the proxy serves a local client (Claude Code /
# Codex) and ignores client auth, so 0.0.0.0 would expose the inference
# endpoint to the whole LAN. Set 0.0.0.0 only to serve other machines.
HOST=127.0.0.1
PORT=8083
# LOG_LEVEL controls all proxy output. One key, four modes:
#   DEBUG   — everything (backend request/response bodies, SSE chunks, thinking content)
#   INFO    — proxy traffic + access logs; dashboard 200s suppressed (default, balanced)
#   WARNING — only warnings, errors, and non-2xx access logs
#   ERROR   — only errors
LOG_LEVEL=WARNING

# Claude Code routinely requests >4k tokens per turn, especially with
# tool-use loops; reasoning-style models (Kimi-K2.5, DeepSeek-V3.2,
# GLM-5, Qwen3 thinking variants) also burn budget on hidden reasoning
# before producing visible output. 16k is a safer default; lower it if
# your provider's per-request cap is tighter.
MAX_TOKENS_LIMIT=16384
#MIN_TOKENS_LIMIT=4096
REQUEST_TIMEOUT=90
MAX_RETRIES=2

# Observability dashboard
OBSERVABILITY_ENABLED=true
# Non-Docker installs fall back to "observability.sqlite3" in the current
# working directory (see src/core/config.py). Docker users get the
# /app/data/... path via docker-compose.yml's environment override and the
# matching ./data:/app/data bind mount, so this line is intentionally
# omitted to avoid breaking host installs that don't have /app.
OBSERVABILITY_QUEUE_SIZE=1000
# Keep tool argument storage off unless you explicitly need deeper debugging.
OBSERVABILITY_STORE_TOOL_ARGS=false

# Statusline percentage offset: tune the free/% used reported in the
# Claude Code statusline. Negative = show more free (e.g. -10 makes 80%
# show as 90% free). Positive = show less free (e.g. +20 makes 80% show
# as 60% free). Range -100 to +100.
STATUSLINE_PERCENT_ADJUST=0
# Model metadata (pricing, context length, listing) is fetched dynamically from
# the provider's GET /v1/models?verbose=true. MODEL_PRICES_JSON below is now an
# OPTIONAL override/fallback (used when the catalog is unreachable, to correct a
# price, or to set advertised_tok_s). Empty is fine.
MODEL_CATALOG_ENABLED=true
MODEL_CATALOG_REFRESH_SECONDS=3600
MODEL_PRICES_JSON='{"moonshotai/Kimi-K2.6":{"input_per_1m":0.95,"output_per_1m":4.00,"advertised_tok_s":60,"currency":"USD"},"deepseek-ai/DeepSeek-V3.2":{"input_per_1m":0.30,"output_per_1m":0.45,"advertised_tok_s":20,"currency":"USD"},"Qwen/Qwen3-235B-A22B-Instruct-2507":{"input_per_1m":0.20,"output_per_1m":0.60,"advertised_tok_s":85,"currency":"USD"},"Qwen/Qwen2.5-VL-72B-Instruct":{"input_per_1m":0.75,"output_per_1m":0.13,"currency":"USD"},"meta-llama/Llama-3.3-70B-Instruct":{"input_per_1m":0.10,"output_per_1m":0.40,"advertised_tok_s":20,"currency":"USD"},"MiniMaxAI/MiniMax-M2.5":{"input_per_1m":0.30,"output_per_1m":1.20,"advertised_tok_s":127,"currency":"USD"},"deepseek-ai/DeepSeek-V4-Pro":{"input_per_1m":1.75,"output_per_1m":3.50,"advertised_tok_s":24,"currency":"USD"},"Qwen/Qwen3-32B":{"input_per_1m":0.30,"output_per_1m":0.10,"advertised_tok_s":60,"currency":"USD"}}'
TAVILY_API_KEY=your_tavily_api_key_here
# Server-side web search (Tavily): with TAVILY_API_KEY set above, the proxy
# executes web_search/WebSearch itself (Claude Code's search can't run behind a
# non-Anthropic backend) and feeds results back to the model. Unset key = off.
SERVER_SEARCH_ENABLED=true
TAVILY_MAX_RESULTS=5
SERVER_SEARCH_MAX_ITERS=4

# Codex proxy (Responses API /v1/responses)
CODEX_ENABLED=true
CODEX_TOOL_COMPAT=true
CODEX_SESSION_TTL_SECONDS=3600
# Codex CLI first tries WebSocket to /v1/responses; if enabled the proxy
# returns 426 Upgrade Required so Codex falls back to HTTP POST.
CODEX_WEBSOCKET_FALLBACK=true

# Ensemble streaming (hedge racing) — race one request across several models
#   off      = normal single-model proxying (default)
#   hedge    = race ENSEMBLE_MODELS in parallel; auto-pick the best response
#              (tool-call validity > finish_reason > speed); losers and the
#              winner's verdict appear under the session in the dashboard
#   approval = race, then hold the stream (pings keep Claude Code alive) until
#              you pick a winner on the dashboard; on timeout the auto-winner
#              is sent. Token cost is roughly N× — built for unlimited plans.
# These ENSEMBLE_* values are the per-session DEFAULTS; `claude --proxy`
# prompts can override mode/models/judge for an individual session.
ENSEMBLE_MODE=approval
ENSEMBLE_MODELS=moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.5
ENSEMBLE_APPROVAL_TIMEOUT_S=120
# Optional LLM judge for rule-score ties (e.g. both candidates made clean tool
# calls). Same Token Factory API key — just a model name. Empty = rules only.
ENSEMBLE_JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ---------------------------------------------------------------------------
# Langfuse observability — prompt/response tracing, metrics, training data
# ---------------------------------------------------------------------------
# Set LANGFUSE_ENABLED=true to capture every proxied LLM call (full
# prompt + response + usage + tool calls) as a Langfuse trace. This is the
# data you'll later export as a fine-tuning dataset.
# When false (or keys unset), all Langfuse calls are silent no-ops — the
# proxy's behavior and performance are unchanged.
LANGFUSE_ENABLED=true
# Self-hosted Langfuse URL. For host/non-Docker runs use http://localhost:8084;
# the proxy container reaches it over the shared network via LANGFUSE_HOST_DOCKER
# (set automatically in docker-compose.yml).
LANGFUSE_HOST=http://localhost:8084
LANGFUSE_HOST_DOCKER=http://langfuse-web:3000
# Public/secret API keys from Langfuse → Project Settings → API Keys.
# Create a project at http://localhost:3000 after `docker compose up`.
LANGFUSE_PUBLIC_KEY=pk-lf-e8b71fa6-57ee-4a7f-8388-7efb59900c78
LANGFUSE_SECRET_KEY=sk-lf-e4821196-b655-4716-9682-3ae7f1247fa6
# Optional. The Langfuse project id, used to build deep-links from the proxy
# dashboard's request rows to each trace. Find it in the Langfuse UI URL bar
# (http://localhost:8084/project/<project_id>/...). Leave blank to hide links.
LANGFUSE_PROJECT_ID=''
# Seconds between background flushes to Langfuse (higher = less latency cost).
LANGFUSE_FLUSH_INTERVAL=10
# Max events queued internally before the SDK drops them.
LANGFUSE_MAX_QUEUE_SIZE=1000

# --- Langfuse self-hosted stack (docker-compose) -----------------------------
# These are used ONLY by the langfuse-web container, not the proxy.
# Generate NEXTAUTH_SECRET/SALT/ENCRYPTION_KEY with: openssl rand -base64 32
# Port map: proxy=8083, langfuse-web=8084, postgres=8085.
NEXTAUTH_URL=http://localhost:8084
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
SALT=replace-me-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32
# Postgres credentials for Langfuse's own database (separate from proxy data).
LANGFUSE_AUTH_POSTGRES_USER=langfuse
LANGFUSE_AUTH_POSTGRES_PASSWORD=langfuse